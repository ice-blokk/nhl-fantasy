// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Player {
  id             Int     @id @default(autoincrement())
  nhlId          Int     @unique
  firstName      String
  lastName       String
  positionCode   String
  sweaterNumber  Int
  shootsCatches  String
  heightInInches Int
  weightInPounds Int
  birthCity      String?
  birthCountry   String?

  @@index([lastName])
  @@index([positionCode])
  @@index([birthCountry])
  @@index([shootsCatches])
  @@index([positionCode, shootsCatches])
}
